{
  "name": "garage-lab-inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "dev:lan": "concurrently \"npm:server\" \"npm:client:lan\"",
    "client": "vite --host 0.0.0.0 --configLoader runner",
    "client:lan": "vite --host 0.0.0.0 --configLoader runner",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "build": "vite build --configLoader runner",
    "build:pages": "npm.cmd run pages:seed && set VITE_STORAGE_MODE=browser&& vite build --configLoader runner",
    "pages:seed": "node scripts/exportSeedData.js",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner",
    "lan": "concurrently \"npm:server\" \"npm:preview\"",
    "online": "npm.cmd run build && node server/index.js",
    "ip": "powershell -NoProfile -Command \"Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -like '192.168.*' -or $_.IPAddress -like '10.*' -or $_.IPAddress -like '172.*' } | Select-Object IPAddress,InterfaceAlias\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "vite": "^7.2.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {}
}
